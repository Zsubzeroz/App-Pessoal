{
  "name": "app-pessoal",
  "version": "1.0.0",
  "description": "App Pessoal Central Luan",
  "author": "Luan Estifer <luan@estifer.com>",
  "private": true,
  "type": "module",
  "main": "electron-main.js",
  "homepage": "./",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zsubzeroz/App-Pessoal.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron-dev": "cross-env NODE_ENV=development concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron-build": "npm run build && electron-builder --win --linux",
    "electron-build:win": "npm run build && electron-builder --win",
    "electron-build:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.luanestifer.app",
    "files": [
      "dist/**/*",
      "electron-main.js",
      "preload.js",
      "package.json"
    ],
    "directories": {
      "buildResources": "public"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "public/favicon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.2.1",
    "electron-builder": "^24.13.3",
    "vite": "^5.0.12",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  }
}
